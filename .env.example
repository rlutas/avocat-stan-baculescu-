# Resend API Key for contact form emails
# Get your API key from https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 Measurement ID
# Get your ID from: Google Analytics > Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Verification Code
# Get it from: Google Search Console > Settings > Ownership verification > HTML tag
# Copy only the content value from the meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# Note: Auth is not active by default. See docs/supabase-setup.md for activation.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
